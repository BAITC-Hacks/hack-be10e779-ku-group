# Скопируйте в .env: cp .env.example .env — приложение стартует без правок, в демо-режиме.

# demo — сохранённые ответы модели из data/ai-cache/; live — живые вызовы OpenAI API (нужен LLM_API_KEY)
APP_MODE=demo
# Ключ OpenAI API. Пусто — работает демо-режим. Никогда не коммитить.
LLM_API_KEY=
# Модель для живого режима
LLM_MODEL=gpt-5.4-mini
# Адрес OpenAI-совместимого API. Пусто — OpenAI. Для NVIDIA NIM: https://integrate.api.nvidia.com/v1
LLM_BASE_URL=
# Порт на хосте (внутри контейнера всегда 8000)
APP_PORT=8000
