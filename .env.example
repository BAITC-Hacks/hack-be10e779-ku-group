# Скопируйте в .env: cp .env.example .env — приложение стартует без правок, в режиме проверки (без ключа).

# demo — режим проверки без ключа: шаги агента выбирает детерминированный планировщик, LLM не вызывается,
# погода, модель и расчёты настоящие; live — шаги выбирает LLM через вызовы инструментов (нужен LLM_API_KEY)
APP_MODE=demo
# Ключ OpenAI API. Пусто — режим проверки. Никогда не коммитить.
LLM_API_KEY=
# Модель для живого режима
LLM_MODEL=gpt-5.4-mini
# Адрес OpenAI-совместимого API. Пусто — OpenAI. Для NVIDIA NIM: https://integrate.api.nvidia.com/v1
LLM_BASE_URL=
# Порт на хосте (внутри контейнера всегда 8000)
APP_PORT=8000
# Погода: 1 — агент сам запрашивает Open-Meteo на окно выпуска (без сети — откат на data/weather/); 0 — только архив
WEATHER_ONLINE=1
# Авторизация: действия (прогноз, прогоны, станции) — по ролям; чтение открыто. 0 — отключить проверку.
AUTH_REQUIRED=1
# Секрет подписи токенов. В продакшене обязательно сменить.
AUTH_SECRET=change-me-in-production
# Тестовые учётки «логин:пароль:роль» через запятую (роли: dispatcher, analyst, admin); demo — демонстратор со всеми правами
AUTH_USERS=admin:admin123:admin,analyst:analyst123:analyst,dispatcher:dispatcher123:dispatcher,demo:demo:admin
